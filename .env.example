# Django Security & Debug
DJANGO_SECRET_KEY=your-production-secret-key-here
DEBUG=False

# Allowed Hosts & Domains (comma-separated)
ALLOWED_HOSTS=yourdomain.ir,www.yourdomain.ir,127.0.0.1,localhost

# CSRF Trusted Origins (comma-separated)
CSRF_TRUSTED_ORIGINS=https://yourdomain.ir,https://www.yourdomain.ir

# Gunicorn & Server Configuration
PORT=8000
WEB_CONCURRENCY=2
PYTHON_MAX_THREADS=2
GUNICORN_TIMEOUT=120
